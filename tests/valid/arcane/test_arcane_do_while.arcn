arcane DoWhile (do: key, body: code, while: key, cond: expr) {
  rules [
    @standard : do [ body while cond ];

  ];

  @standard {

    do <=> #loop {
      body;

      if (!cond) { break; }
    };

  }

}

func main() -> int {

  int i = 4;
  int j = 1;

  do {
    i = i - 1;
    j = j * 2;

  } while (i);


  return j;

}
